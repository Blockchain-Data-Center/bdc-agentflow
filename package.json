{
  "name": "bdc-agentflow",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "wallets:create": "node --import tsx scripts/wallets-create.ts",
    "wallets:check": "node --import tsx scripts/wallets-check.ts",
    "capture:token-intel": "node --env-file=.env --import tsx scripts/capture-token-intel.ts",
    "e2e:devnet": "node --env-file=.env --import tsx scripts/e2e-devnet.ts"
  },
  "dependencies": {
    "@solana/kit": "5.5.1",
    "@x402/core": "2.28.0",
    "@x402/express": "2.28.0",
    "@x402/fetch": "2.28.0",
    "@x402/svm": "2.28.0",
    "express": "5.3.0"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
